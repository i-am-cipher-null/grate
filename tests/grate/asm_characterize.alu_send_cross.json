			"name": "xfer-s0-s1",
			"fs": "tests/grate/asm/alu_send_cross.in",
			"replace": {
				"fs": {
					"@ABUF@": "1",
					"@A0@": "MAD  r2.l*,  u3,  #1,  #0 (other)",
					"@A1@": "NOP",
					"@A2@": "NOP",
					"@A3@": "NOP",
					"@A4@": "MAD  r2.l*,  u2,  #1,  #0",
					"@A5@": "MAD  r0.l*,  u0,  #1,  #0 (this)",
					"@A6@": "NOP",
					"@A7@": "NOP",
					"@B0@": "NOP",
					"@B1@": "NOP",
					"@B2@": "NOP",
					"@B3@": "NOP",
					"@C0@": "NOP",
					"@C1@": "NOP",
					"@C2@": "NOP",
					"@C3@": "NOP",
					"@D0@": "NOP",
					"@D1@": "store rt1, r0, r1",
					"@D2@": "NOP"
				}
			},
			"environment": {
				"GRATE_DUMP_RAW": "1"
			},
			"expected_note": "sender packet 0 slot 0 sends 0x60, receiver packet 1 slot 1 receives 0x10, and the receiver's previous slot (packet 1 slot 0) writes 0x40: 0x70 if the sender crossed the packet boundary, 0x50 if only the receiver's own previous slot was added, 0x10 if neither",
			"expected": "0x00000050"
		},
