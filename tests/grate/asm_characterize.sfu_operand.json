{
	"name": "sfu-operand",
	"repeat": 3,
	"timeout": 10,
	"program": {
		"vs": "tests/grate/asm/vs_mov.txt",
		"fs": "tests/grate/asm/mfu_sel.in",
		"lnk": "tests/grate/asm/linker_vs_tests.txt"
	},
	"controls": [
		{
			"name": "immediate-operand",
			"fs": "tests/grate/asm/fs_alu_immediate_control.txt",
			"expected": "0x000000FF"
		},
		{
			"name": "varying-pipeline",
			"fs": "tests/grate/asm/fs_vs_tests.txt",
			"expected": "0xFF01FF00"
		}
	],
	"variants": [
		{
			"name": "fp20-none-store23",
			"environment": {
				"GRATE_POKE": "0x520=0x20006003"
			},
			"replace": {
				"fs": {
					"@P0@": "MAD  r0.lh,  u0,  #1,  #0",
					"@P1@": "MAD  r1.lh,  u1,  #1,  #0",
					"@P2@": "MAD  r2.lh,  u2,  #1,  #0",
					"@P3@": "MAD  r3.lh,  u3,  #1,  #0",
					"@MFU@": "NOP",
					"@STORE@": "store rt1, r2, r3"
				}
			},
			"fs": "tests/grate/asm/mfu_sel.in",
			"expected": "0xEB00E700"
		},
		{
			"name": "fp20-sqrt3-only",
			"environment": {
				"GRATE_POKE": "0x520=0x20006003"
			},
			"replace": {
				"fs": {
					"@P0@": "MAD  r0.lh,  u0,  #1,  #0",
					"@P1@": "MAD  r1.lh,  u1,  #1,  #0",
					"@P2@": "MAD  r2.lh,  u2,  #1,  #0",
					"@P3@": "MAD  r3.lh,  u3,  #1,  #0",
					"@MFU@": "sfu: sqrt r3",
					"@STORE@": "store rt1, r2, r3"
				}
			},
			"fs": "tests/grate/asm/mfu_sel.in",
			"expected": "0xF000E700"
		},
		{
			"name": "fp20-sqrt3-src10",
			"environment": {
				"GRATE_POKE": "0x520=0x20006003"
			},
			"replace": {
				"fs": {
					"@P0@": "MAD  r0.lh,  u0,  #1,  #0",
					"@P1@": "MAD  r1.lh,  u1,  #1,  #0",
					"@P2@": "MAD  r2.lh,  u2,  #1,  #0",
					"@P3@": "MAD  r3.lh,  u3,  #1,  #0",
					"@MFU@": "sfu: sqrt r3 mul0: r2, src10, #1",
					"@STORE@": "store rt1, r2, r3"
				}
			},
			"fs": "tests/grate/asm/mfu_sel.in",
			"expected": "0xF000F000"
		},
		{
			"name": "fp20-sqrt2-src10",
			"environment": {
				"GRATE_POKE": "0x520=0x20006003"
			},
			"replace": {
				"fs": {
					"@P0@": "MAD  r0.lh,  u0,  #1,  #0",
					"@P1@": "MAD  r1.lh,  u1,  #1,  #0",
					"@P2@": "MAD  r2.lh,  u2,  #1,  #0",
					"@P3@": "MAD  r3.lh,  u3,  #1,  #0",
					"@MFU@": "sfu: sqrt r2 mul0: r2, src10, #1",
					"@STORE@": "store rt1, r2, r3"
				}
			},
			"fs": "tests/grate/asm/mfu_sel.in",
			"expected": "0xEB00EF00"
		},
		{
			"name": "fp20-sqrt0-src10",
			"environment": {
				"GRATE_POKE": "0x520=0x20006003"
			},
			"replace": {
				"fs": {
					"@P0@": "MAD  r0.lh,  u0,  #1,  #0",
					"@P1@": "MAD  r1.lh,  u1,  #1,  #0",
					"@P2@": "MAD  r2.lh,  u2,  #1,  #0",
					"@P3@": "MAD  r3.lh,  u3,  #1,  #0",
					"@MFU@": "sfu: sqrt r0 mul0: r2, src10, #1",
					"@STORE@": "store rt1, r2, r3"
				}
			},
			"fs": "tests/grate/asm/mfu_sel.in",
			"expected": "0xEB00E700"
		},
		{
			"name": "fp20-rcp3-src10",
			"environment": {
				"GRATE_POKE": "0x520=0x20006003"
			},
			"replace": {
				"fs": {
					"@P0@": "MAD  r0.lh,  u0,  #1,  #0",
					"@P1@": "MAD  r1.lh,  u1,  #1,  #0",
					"@P2@": "MAD  r2.lh,  u2,  #1,  #0",
					"@P3@": "MAD  r3.lh,  u3,  #1,  #0",
					"@MFU@": "sfu: rcp r3 mul0: r2, src10, #1",
					"@STORE@": "store rt1, r2, r3"
				}
			},
			"fs": "tests/grate/asm/mfu_sel.in",
			"expected": "0xFF00FF00"
		}
	]
}
