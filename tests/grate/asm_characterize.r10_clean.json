{
	"name": "r10-clean",
	"repeat": 3,
	"timeout": 20,
	"program": {
		"vs": "tests/grate/asm/vs_mov.txt",
		"fs": "tests/grate/asm/r10_clean.in",
		"lnk": "tests/grate/asm/linker_vs_tests.txt"
	},
	"controls": [
		{
			"name": "immediate-operand",
			"fs": "tests/grate/asm/fs_alu_immediate_control.txt",
			"expected": "0x000000FF"
		},
		{
			"name": "varying-pipeline",
			"fs": "tests/grate/asm/fs_vs_tests.txt",
			"expected": "0xFF01FF00"
		}
	],
	"variants": [
		{
			"name": "r10-seed4",
			"replace": {
				"fs": {
					"@SEED@": "MAD  r10.lh,  u0,  #1,  #0",
					"@SFU@": "rcp r10"
				}
			}
		},
		{
			"name": "r10-seed1",
			"replace": {
				"fs": {
					"@SEED@": "MAD  r10.lh,  u2,  #1,  #0",
					"@SFU@": "rcp r10"
				}
			}
		},
		{
			"name": "r10-unseeded",
			"replace": {
				"fs": {
					"@SEED@": "NOP",
					"@SFU@": "rcp r10"
				}
			}
		},
		{
			"name": "r0-seed4",
			"replace": {
				"fs": {
					"@SEED@": "MAD  r0.lh,  u0,  #1,  #0",
					"@SFU@": "rcp r0"
				}
			}
		},
		{
			"name": "r4-pipeline",
			"replace": {
				"fs": {
					"@SEED@": "NOP",
					"@SFU@": "rcp r4"
				}
			}
		}
	]
}
