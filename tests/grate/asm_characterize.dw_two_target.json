{
	"name": "dw-two-target",
	"repeat": 3,
	"timeout": 20,
	"program": {
		"vs": "tests/grate/asm/vs_mov.txt",
		"fs": "tests/grate/asm/dw_two_target.in",
		"lnk": "tests/grate/asm/linker_vs_tests.txt"
	},
	"controls": [
		{
			"name": "immediate-operand",
			"vs": "tests/grate/asm/vs_mov.txt",
			"fs": "tests/grate/asm/fs_alu_immediate_control.txt",
			"lnk": "tests/grate/asm/linker_vs_tests.txt",
			"expected": "0x000000FF"
		},
		{
			"name": "varying-pipeline",
			"vs": "tests/grate/asm/vs_mov.txt",
			"fs": "tests/grate/asm/fs_vs_tests.txt",
			"lnk": "tests/grate/asm/linker_vs_tests.txt",
			"expected": "0xFF01FF00"
		}
	],
	"variants": [
		{
			"name": "two-a1-b4-read1",
			"fs": "tests/grate/asm/dw_two_target.in",
			"replace": {
				"fs": {
					"@DW0@": "store rt1, r0, r1",
					"@DW1@": "store rt4, r0, r1",
					"@DW2@": "store rt1, r0, r1",
					"@DW3@": "NOP",
					"@FETCH@": "load rt1, r0, r1"
				}
			},
			"environment": {
				"GRATE_RT4": "1"
			},
			"expected_note": "DW to rt1 in batch 0, DW to rt4 in batch 1; read rt1 before the readback store changes it",
			"expected": "0x3D2C1B0A"
		},
		{
			"name": "two-a1-b4-read4",
			"fs": "tests/grate/asm/dw_two_target.in",
			"replace": {
				"fs": {
					"@DW0@": "store rt1, r0, r1",
					"@DW1@": "store rt4, r0, r1",
					"@DW2@": "store rt1, r0, r1",
					"@DW3@": "NOP",
					"@FETCH@": "load rt4, r0, r1"
				}
			},
			"environment": {
				"GRATE_RT4": "1"
			},
			"expected_note": "the same program, read rt4",
			"expected": "0x00000000"
		},
		{
			"name": "two-a4-b1-read1",
			"fs": "tests/grate/asm/dw_two_target.in",
			"replace": {
				"fs": {
					"@DW0@": "store rt4, r0, r1",
					"@DW1@": "store rt1, r0, r1",
					"@DW2@": "store rt1, r0, r1",
					"@DW3@": "NOP",
					"@FETCH@": "load rt1, r0, r1"
				}
			},
			"environment": {
				"GRATE_RT4": "1"
			},
			"expected_note": "the same two DWs with the batch order swapped; read rt1",
			"expected": "0x00000000"
		},
		{
			"name": "two-a4-b1-read4",
			"fs": "tests/grate/asm/dw_two_target.in",
			"replace": {
				"fs": {
					"@DW0@": "store rt4, r0, r1",
					"@DW1@": "store rt1, r0, r1",
					"@DW2@": "store rt1, r0, r1",
					"@DW3@": "NOP",
					"@FETCH@": "load rt4, r0, r1"
				}
			},
			"environment": {
				"GRATE_RT4": "1"
			},
			"expected_note": "the swapped program, read rt4",
			"expected": "0x3D2C1B0A"
		},
		{
			"name": "two-a1-b1-read1",
			"fs": "tests/grate/asm/dw_two_target.in",
			"replace": {
				"fs": {
					"@DW0@": "store rt1, r0, r1",
					"@DW1@": "store rt1, r0, r1",
					"@DW2@": "store rt1, r0, r1",
					"@DW3@": "NOP",
					"@FETCH@": "load rt1, r0, r1"
				}
			},
			"environment": {
				"GRATE_RT4": "1"
			},
			"expected_note": "both DWs on rt1 - the arrangement section 3 measured - read rt1",
			"expected": "0x00000000"
		},
		{
			"name": "two-a1-b1-read4",
			"fs": "tests/grate/asm/dw_two_target.in",
			"replace": {
				"fs": {
					"@DW0@": "store rt1, r0, r1",
					"@DW1@": "store rt1, r0, r1",
					"@DW2@": "store rt1, r0, r1",
					"@DW3@": "NOP",
					"@FETCH@": "load rt4, r0, r1"
				}
			},
			"environment": {
				"GRATE_RT4": "1"
			},
			"expected_note": "the same, read rt4: the untouched-target control for that pair",
			"expected": "0x00000000"
		},
		{
			"name": "single-1-read1",
			"fs": "tests/grate/asm/dw_two_target.in",
			"replace": {
				"fs": {
					"@DW0@": "store rt1, r0, r1",
					"@DW1@": "NOP",
					"@DW2@": "store rt1, r0, r1",
					"@DW3@": "NOP",
					"@FETCH@": "load rt1, r0, r1"
				}
			},
			"environment": {
				"GRATE_RT4": "1"
			},
			"expected_note": "one DW in the group's first batch, on rt1: the positive control",
			"expected": "0x3D2C1B0A"
		},
		{
			"name": "single-1-read4",
			"fs": "tests/grate/asm/dw_two_target.in",
			"replace": {
				"fs": {
					"@DW0@": "store rt1, r0, r1",
					"@DW1@": "NOP",
					"@DW2@": "store rt1, r0, r1",
					"@DW3@": "NOP",
					"@FETCH@": "load rt4, r0, r1"
				}
			},
			"environment": {
				"GRATE_RT4": "1"
			},
			"expected_note": "the same program, read rt4: rt4 must keep its baseline",
			"expected": "0x00000000"
		},
		{
			"name": "single-4-read4",
			"fs": "tests/grate/asm/dw_two_target.in",
			"replace": {
				"fs": {
					"@DW0@": "store rt4, r0, r1",
					"@DW1@": "NOP",
					"@DW2@": "store rt1, r0, r1",
					"@DW3@": "NOP",
					"@FETCH@": "load rt4, r0, r1"
				}
			},
			"environment": {
				"GRATE_RT4": "1"
			},
			"expected_note": "one DW, on rt4: the positive control for rt4",
			"expected": "0x3D2C1B0A"
		},
		{
			"name": "single-4-read1",
			"fs": "tests/grate/asm/dw_two_target.in",
			"replace": {
				"fs": {
					"@DW0@": "store rt4, r0, r1",
					"@DW1@": "NOP",
					"@DW2@": "store rt1, r0, r1",
					"@DW3@": "NOP",
					"@FETCH@": "load rt1, r0, r1"
				}
			},
			"environment": {
				"GRATE_RT4": "1"
			},
			"expected_note": "the same program, read rt1: rt1 must keep its baseline",
			"expected": "0x4C4C4C4C"
		},
		{
			"name": "single-b-1-read1",
			"fs": "tests/grate/asm/dw_two_target.in",
			"replace": {
				"fs": {
					"@DW0@": "NOP",
					"@DW1@": "store rt1, r0, r1",
					"@DW2@": "store rt1, r0, r1",
					"@DW3@": "NOP",
					"@FETCH@": "load rt1, r0, r1"
				}
			},
			"environment": {
				"GRATE_RT4": "1"
			},
			"expected_note": "the group's only DW sits in its second batch, on rt1: section 3 says that position stores nothing",
			"expected": "0x00000000"
		},
		{
			"name": "single-b-4-read4",
			"fs": "tests/grate/asm/dw_two_target.in",
			"replace": {
				"fs": {
					"@DW0@": "NOP",
					"@DW1@": "store rt4, r0, r1",
					"@DW2@": "store rt1, r0, r1",
					"@DW3@": "NOP",
					"@FETCH@": "load rt4, r0, r1"
				}
			},
			"environment": {
				"GRATE_RT4": "1"
			},
			"expected_note": "the same position on rt4, so the position rule is not an artefact of the colour target",
			"expected": "0x00000000"
		},
		{
			"name": "none-read1",
			"fs": "tests/grate/asm/dw_two_target.in",
			"replace": {
				"fs": {
					"@DW0@": "NOP",
					"@DW1@": "NOP",
					"@DW2@": "store rt1, r0, r1",
					"@DW3@": "NOP",
					"@FETCH@": "load rt1, r0, r1"
				}
			},
			"environment": {
				"GRATE_RT4": "1"
			},
			"expected_note": "no DW in the group: what rt1 holds before any store",
			"expected": "0x4C4C4C4C"
		},
		{
			"name": "none-read4",
			"fs": "tests/grate/asm/dw_two_target.in",
			"replace": {
				"fs": {
					"@DW0@": "NOP",
					"@DW1@": "NOP",
					"@DW2@": "store rt1, r0, r1",
					"@DW3@": "NOP",
					"@FETCH@": "load rt4, r0, r1"
				}
			},
			"environment": {
				"GRATE_RT4": "1"
			},
			"expected_note": "no DW in the group: what rt4 holds before any store",
			"expected": "0x00000000"
		}
	]
}
