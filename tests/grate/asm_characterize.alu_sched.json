				"fs": {
					"@A0@": "MAD  r2.l*,  u0,  #1,  #0",
					"@A1@": "MAD  r0.l*,  alu0.l,  #1,  #0",
					"@A2@": "MAD  r1.l*,  alu1.l,  #1,  #0",
					"@A3@": "NOP",
					"@D0@": "store rt1, r0, r1",
					"@B0@": "NOP",
					"@B1@": "NOP",
					"@B2@": "NOP",
					"@B3@": "NOP",
					"@D1@": "NOP"
				}
			},
			"environment": {
				"GRATE_DUMP_RAW": "1"
			},
			"expected_note": "a two-link latch chain and a store in the same batch: 0x00100010 if both links read the previous slot (no bits set: the control); schedule mask 0x00000000",
			"expected": "0x00100010"
		},
