{
	"name": "mfu-high-group",
	"repeat": 3,
	"timeout": 20,
	"program": {
		"vs": "tests/grate/asm/vs_mov.txt",
		"fs": "tests/grate/asm/mfu_high_group.in",
		"lnk": "tests/grate/asm/linker_vs_tests.txt"
	},
	"controls": [
		{
			"name": "immediate-operand",
			"fs": "tests/grate/asm/fs_alu_immediate_control.txt",
			"expected": "0x000000FF"
		},
		{
			"name": "varying-pipeline",
			"fs": "tests/grate/asm/fs_vs_tests.txt",
			"expected": "0xFF01FF00"
		}
	],
	"variants": [
		{
			"name": "both",
			"replace": {
				"fs": {
					"@SEED0@": "MAD  r0.lh,  u0,  #1,  #0",
					"@SEED1@": "MAD  r1.lh,  u1,  #1,  #0",
					"@SFU@": "rcp r10"
				}
			}
		},
		{
			"name": "swap",
			"replace": {
				"fs": {
					"@SEED0@": "MAD  r0.lh,  u1,  #1,  #0",
					"@SEED1@": "MAD  r1.lh,  u0,  #1,  #0",
					"@SFU@": "rcp r10"
				}
			}
		},
		{
			"name": "only-r0",
			"replace": {
				"fs": {
					"@SEED0@": "MAD  r0.lh,  u0,  #1,  #0",
					"@SEED1@": "NOP",
					"@SFU@": "rcp r10"
				}
			}
		},
		{
			"name": "only-r1",
			"replace": {
				"fs": {
					"@SEED0@": "NOP",
					"@SEED1@": "MAD  r1.lh,  u1,  #1,  #0",
					"@SFU@": "rcp r10"
				}
			}
		},
		{
			"name": "both-r15",
			"replace": {
				"fs": {
					"@SEED0@": "MAD  r0.lh,  u0,  #1,  #0",
					"@SEED1@": "MAD  r1.lh,  u1,  #1,  #0",
					"@SFU@": "rcp r15"
				}
			}
		}
	]
}
