					"@B5@": "NOP",
					"@B6@": "NOP",
					"@B7@": "NOP",
					"@D0@": "NOP",
					"@D1@": "NOP",
					"@D2@": "NOP",
					"@D3@": "NOP",
					"@D4@": "store rt1, r0, r1",
					"@D5@": "NOP",
