					"@B1@": "NOP",
					"@B2@": "NOP",
					"@B3@": "MAD  r2.l*,  u3,  #1,  #0",
					"@B4@": "NOP",
					"@B5@": "NOP",
					"@B6@": "NOP",
					"@B7@": "NOP",
					"@D0@": "NOP",
					"@D1@": "NOP",
					"@D2@": "NOP",
					"@D3@": "NOP",
