			"replace": {
				"fs": {
					"@SEED@": "MAD  r10.lh,  u0,  #1,  #0",
					"@SFU@": "rcp r10"
				}
			}
		},
		{
			"name": "seed1-rcp-r10",
			"replace": {
				"fs": {
					"@SEED@": "MAD  r10.lh,  u1,  #1,  #0",
					"@SFU@": "rcp r10"
				}
			}
		},
		{
			"name": "seed-half-rcp-r10",
			"replace": {
				"fs": {
					"@SEED@": "MAD  r10.lh,  u2,  #1,  #0",
					"@SFU@": "rcp r10"
				}
			}
		},
		{
			"name": "unseeded-rcp-r10",
			"replace": {
				"fs": {
					"@SEED@": "NOP",
					"@SFU@": "rcp r10"
				}
			}
		},
		{
			"name": "seed4-sfu-nop",
			"replace": {
				"fs": {
					"@SEED@": "MAD  r10.lh,  u0,  #1,  #0",
					"@SFU@": "nop r0"
				}
			}
		},
		{
			"name": "seed4-rcp-r4",
			"replace": {
				"fs": {
					"@SEED@": "MAD  r10.lh,  u0,  #1,  #0",
					"@SFU@": "rcp r4"
				}
