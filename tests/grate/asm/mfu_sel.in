alu_buffer_size = 1
pseq_to_dw_exec_nb = 1

/*
 * One MFU word, isolated: how does the multiplier's source number select its
 * operand, what do the numbers past the four row registers read, and which row
 * register does its destination field write?
 *
 * Batch 0 primes the four row registers with four distinct constants, so a
 * multiplier reading row register N returns byte N of the .constants table
 * (0x10, 0x20, 0x40, 0x60) and no other number can. Batch 1 holds exactly one
 * MFU sub-instruction - a single mul0 with the source, destination or operand
 * under test - and batch 2 stores one register pair. Between variants only the
 * field under test changes.
 *
 * The multiplier reads its operands from the current row, and at
 * alu_buffer_size 1 the program has a single row, so what batch 0 primed is
 * what batch 1's multiplier reads. A variant whose multiplier does not write
 * the stored registers leaves their primes in place - which is what the variant
 * with no MFU word returns.
 *
 * The store line is a placeholder: `store rt1, r2, r3` readback covers r2 and
 * r3, `store rt1, r0, r1` covers r0 and r1. Both layout the first register in
 * bits 0..15 and the second in bits 16..31, .lo before .hi within each half.
 */

.constants
	[0] = 0.0625;
	[1] = 0.125;
	[2] = 0.25;
	[3] = 0.375;

.asm
EXEC
	ALU:
		ALU0:	@P0@
		ALU1:	@P1@
		ALU2:	@P2@
		ALU3:	@P3@
;
EXEC
	MFU:	@MFU@
;
EXEC
	DW:	@STORE@
;
