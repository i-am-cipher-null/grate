alu_buffer_size = 1
pseq_to_dw_exec_nb = 1

/*
 * Per-batch ALU schedule-bit template: three batches, one ALU packet and one DW
 * word each, every batch its own group (alu_buffer_size 1).
 *
 *   batch 0  the producer packet     (A0..A3, D0)
 *   batch 1  the consumer packet     (B0..B3, D1)
 *   batch 2  the readback packet     (C0..C3, D2)
 *
 * Section 30 set bits 29 and 30 of the 0x801 words with GRATE_ALU_SCHED_OR,
 * which reaches every batch at once, so a bit that only matters for the packet
 * it is attached to would be averaged out across the three batches. The hook
 * also takes GRATE_ALU_SCHED_OR_AT, a batch index, so a variant here masks
 * exactly one batch and the others keep the word the assembler would emit.
 *
 * With one packet per batch, the batch index is also the packet index and the
 * group index, so masking batch 0 and masking batch 1 are the producer and the
 * consumer of the same forwarding path (section 31's group carry), and masking
 * batch 2 is a batch that takes no part in the shape at all.
 *
 * Nothing is primed; a reader instruction always writes its destination, so a
 * zero in the stored word is a zero the latch or row actually held.
 */

.constants
	[0] = 0.0625;
	[1] = 0.25;
	[2] = 0.5;
	[3] = 0.125;

.asm
EXEC
	ALU:
		ALU0:	@A0@
		ALU1:	@A1@
		ALU2:	@A2@
		ALU3:	@A3@
	DW:	@D0@
;
EXEC
	ALU:
		ALU0:	@B0@
		ALU1:	@B1@
		ALU2:	@B2@
		ALU3:	@B3@
	DW:	@D1@
;
EXEC
	ALU:
		ALU0:	@C0@
		ALU1:	@C1@
		ALU2:	@C2@
		ALU3:	@C3@
	DW:	@D2@
;
