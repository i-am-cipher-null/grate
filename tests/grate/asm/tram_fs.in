alu_buffer_size = 1
pseq_to_dw_exec_nb = 1

/*
 * TRAM fetch template: four batches, one ipl word, one row-register pair read.
 *
 * batch 0  prime r0..r3, so a fetch that does not write a register leaves a
 *          known value and the readback can name the untouched register
 * batch 1  one MFU word: the standard barycentric prologue plus ipl
 * batch 2  the fp20-to-fx10 readout for a fetched pair
 * batch 3  the store
 *
 * The ipl operand position picks the TRAM component (operand 0 is .x and
 * writes r0, operand 1 .y -> r1, operand 2 .z -> r2, operand 3 .w -> r3), and
 * the tN prefix picks the TRAM row. The fp20 variants convert the two fetched
 * registers with `.l*`, which DW reads as a linear 0..1 byte; the fx10 variants
 * skip the conversion and store the row registers directly, because an fx10
 * fetch is documented to fill both halves of one register.
 */

.constants
	[0] = 0.0625;
	[1] = 0.125;
	[2] = 0.25;
	[3] = 0.375;
	[4] = 0.5;
	[5] = 0.625;
	[6] = 0.75;
	[7] = 0.875;
	[8] = 1.0;

.asm
EXEC
	ALU:
		ALU0:	@P0@
		ALU1:	@P1@
		ALU2:	@P2@
		ALU3:	@P3@
;
EXEC
	MFU:	@MFU@
;
EXEC
	ALU:
		ALU0:	@C0@
		ALU1:	@C1@
;
EXEC
	DW:	@STORE@
;
