/*
 * FragCoord.z readback: fetch one TRAM component and store the row raw.
 *
 * Four batches: prime r0..r3, one MFU word whose ipl operand comes from the
 * manifest, an ALU packet that can copy a fetched x or y into r2, then
 * `store rt1, r2, r3`. The fetch target is chosen by the ipl operand position,
 * so `NOP, NOP, NOP, t0.fp20` puts TRAM0.w in r3 and the stored high half is
 * that component unconverted. r2 stays at the 0.25 prime unless an ALU slot
 * copies into it, and names the word layout in every run.
 */

.constants
	[0] = 0.0625;
	[1] = 0.125;
	[2] = 0.25;
	[3] = 0.375;
	[4] = 0.5;
	[5] = 0.625;
	[6] = 0.75;
	[7] = 0.875;
	[8] = 1.0;

.asm
EXEC
	ALU:
		ALU0:	MAD  r0.lh,  u0,  #1,  #0
		ALU1:	MAD  r1.lh,  u1,  #1,  #0
		ALU2:	MAD  r2.lh,  u2,  #1,  #0
		ALU3:	MAD  r3.lh,  u3,  #1,  #0
;
EXEC
	MFU:	sfu: rcp r4 mul0: bar, sfu, bar0 mul1: bar, sfu, bar1 ipl: @IPL@
;
EXEC
	ALU:
		ALU0:	@C0@
		ALU1:	@C1@
;
EXEC
	DW:	@STORE@
;
