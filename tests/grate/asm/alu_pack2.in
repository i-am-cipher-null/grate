alu_buffer_size = 1
pseq_to_dw_exec_nb = 1

/*
 * Two-packet ALU batch template: three batches, the first with exactly two
 * `ALU:` blocks, the other two with one each.
 *
 * The grammar accepts two `ALU:` blocks and the assembler sets the schedule
 * word's count from the number of blocks, so a batch with two packets is
 * directly expressible: batch 0 emits count 2 at packet address 0, batches 1
 * and 2 emit count 1 at addresses 2 and 3. Section 32 inferred the multi-packet
 * forwarding rule from a batch with three packets; this template lets the same
 * questions be asked of two packets without patching a schedule word.
 *
 *   slot 0..3    batch 0, packet 0
 *   slot 4..7    batch 0, packet 1
 *   slot 8..11   batch 1's only packet
 *   slot 12..15  batch 2's only packet
 *
 * `alu_buffer_size = 1`, so every batch is its own group: a row written in
 * batch 0 is visible to a store in batch 1, and a latch read in batch 1 is the
 * group-boundary carry. A store only produces a word in its group's first
 * batch, which at this size is every batch, so a variant can store from batch 0
 * (same group as the writes), batch 1 or batch 2.
 *
 * Values: u0 = 0.0625 (0x10), u1 = 0.25 (0x40), u2 = 0.5 (0x7F), u3 = 0.125
 * (0x20) as fx10. `store rt1, r0, r1` puts r0.lo in the low byte, then r0.hi,
 * r1.lo, r1.hi, so a reader that lands in r1.lo shows up in byte 2.
 */

.constants
	[0] = 0.0625;
	[1] = 0.25;
	[2] = 0.5;
	[3] = 0.125;

.asm
EXEC
	ALU:
		ALU0:	@A0@
		ALU1:	@A1@
		ALU2:	@A2@
		ALU3:	@A3@
	ALU:
		ALU0:	@A4@
		ALU1:	@A5@
		ALU2:	@A6@
		ALU3:	@A7@
	DW:	@D0@
;
EXEC
	ALU:
		ALU0:	@B0@
		ALU1:	@B1@
		ALU2:	@B2@
		ALU3:	@B3@
	DW:	@D1@
;
EXEC
	ALU:
		ALU0:	@C0@
		ALU1:	@C1@
		ALU2:	@C2@
		ALU3:	@C3@
	DW:	@D2@
;
