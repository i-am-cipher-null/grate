alu_buffer_size = 1
pseq_to_dw_exec_nb = 1

/*
 * Varying read template: interpolate tram0 and store the four components.
 *
 * `store rt1, r2, r3` reads [r3.hi][r3.lo][r2.hi][r2.lo], and the ALU below
 * maps the ipl outputs to those bytes as
 *
 *     r2.lo = y    r2.hi = x    r3.lo = z    r3.hi = w
 *
 * which is the same mapping tests/grate/asm/fs_vs_tests.txt uses.
 */

.asm
EXEC
	MFU:	sfu: rcp r4
		mul0: bar, sfu, bar0
		mul1: bar, sfu, bar1
		ipl: t0.fp20, t0.fp20, t0.fp20, t0.fp20
	ALU:
		ALU0:	MAD  r3.*h,  r3,         #1,  #0,  #1
		ALU1:	MAD  r3.l*,  r2,         #1,  #0,  #1
		ALU2:	MAD  r2.*h,  r0,         #1,  #0,  #1
		ALU3:	MAD  r2.l*,  r1,         #1,  #0,  #1
	DW:	store rt1, r2, r3
;
