alu_buffer_size = @ABUF@
pseq_to_dw_exec_nb = 1

/*
 * Five-packet group, 2 + 1 + 1 + 1 split over 4 batches at `alu_buffer_size` 4.
 *
 * Sections 38, 39, 43 and 44 measured every two- and three-batch five-packet
 * split, and all of them have the complete five-packet cycle, as do the four
 * six-packet splits in section 45. Four-batch groups were the remaining gap.
 * Five packets over four batches force exactly one batch to hold two packets,
 * so these four permutations of 1 + 1 + 1 + 2 hold the packet count and the
 * batch count fixed and move that batch across the group. 1 + 1 + 1 + 2 is the
 * only one in which the group's last packet shares its batch with packet 3.
 *
 *   batch 0  packets 0, 1          A0..A7   group A
 *   batch 1  packet 2              B0..B3   group A
 *   batch 2  packet 3              C0..C3   group A
 *   batch 3  packet 4              E0..E3   group A
 *
 * 4 batches are one whole group at size 4: group A is batches 0 to
 * 3, group B is batches 4 to 7. Group A holds the five packets
 * under test; group B repeats the distribution, and its first batch
 * (4) stores group A's rows through the DW. Group B's ALU blocks are kept
 * so the schedule words show the same distribution twice.
 *
 * The assembler sets each batch's schedule count from its block count and each
 * address from the running ALU instruction index (a 6-bit field in
 * `instr_sched`), so no schedule word is patched; `dump_sched_words.py` reads
 * the counts and addresses back from the run's own dump.
 *
 * Where the result is observed: a row written by a reader in group A is stored
 * by the DW of batch 4, group B's first batch (notes 3, 42, 43). Values:
 * u0 = 0.0625 (0x10), u1 = 0.125 (0x20), u2 = 0.25 (0x40), u3 = 0.375 (0x60),
 * u4 = 0.4375 (0x70) as fx10, so a stored byte names the packet that served
 * the read.
 */

.constants
	[0] = 0.0625;
	[1] = 0.125;
	[2] = 0.25;
	[3] = 0.375;
	[4] = 0.4375;

.asm
EXEC
	ALU:
		ALU0:	@A0@
		ALU1:	@A1@
		ALU2:	@A2@
		ALU3:	@A3@
	ALU:
		ALU0:	@A4@
		ALU1:	@A5@
		ALU2:	@A6@
		ALU3:	@A7@
	DW:	@D0@
;
EXEC
	ALU:
		ALU0:	@B0@
		ALU1:	@B1@
		ALU2:	@B2@
		ALU3:	@B3@
	DW:	@D1@
;
EXEC
	ALU:
		ALU0:	@C0@
		ALU1:	@C1@
		ALU2:	@C2@
		ALU3:	@C3@
	DW:	@D2@
;
EXEC
	ALU:
		ALU0:	@E0@
		ALU1:	@E1@
		ALU2:	@E2@
		ALU3:	@E3@
	DW:	@D3@
;
EXEC
	ALU:
		ALU0:	@F0@
		ALU1:	@F1@
		ALU2:	@F2@
		ALU3:	@F3@
	ALU:
		ALU0:	@F4@
		ALU1:	@F5@
		ALU2:	@F6@
		ALU3:	@F7@
	DW:	@D4@
;
EXEC
	ALU:
		ALU0:	@G0@
		ALU1:	@G1@
		ALU2:	@G2@
		ALU3:	@G3@
	DW:	@D5@
;
EXEC
	ALU:
		ALU0:	@H0@
		ALU1:	@H1@
		ALU2:	@H2@
		ALU3:	@H3@
	DW:	@D6@
;
EXEC
	ALU:
		ALU0:	@J0@
		ALU1:	@J1@
		ALU2:	@J2@
		ALU3:	@J3@
	DW:	@D7@
;
