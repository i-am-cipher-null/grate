alu_buffer_size = 1
pseq_to_dw_exec_nb = 1

/*
 * PRE first step and main second step, with room to move them apart.
 *
 * Batch 0 primes the rows. Batches 1..6 carry three MFU words each, so the two
 * words of a PRE/main pair can sit one to seventeen MFU words apart and cross
 * up to five batch boundaries. Batch 1 also has an ALU stage after its MFU
 * words (the stage order inside a batch is MFU, TEX, ALU), which is where the
 * ALU clobber variants write a register between the two words. The last two
 * batches convert the result registers to fx10 and store them.
 *
 * The main word carries `mul0: r2, sfu, #1` (or r1 for the interleaved pairs),
 * because the SFU result is only visible through the multiplier source. r2 and
 * r1 are the result registers; r0 and r3 hold the operands.
 */

.constants
	[0] = 0.0;
	[1] = 0.0625;
	[2] = 0.125;
	[3] = 0.25;
	[4] = 0.375;
	[5] = 0.5;
	[6] = 0.625;
	[7] = 0.75;
	[8] = 1.0;
	[9] = 1.25;
	[10] = 1.5;
	[11] = 1.75;
	[12] = 2.0;
	[13] = 3.0;
	[14] = 4.0;
	[15] = -0.25;
	[16] = -0.5;
	[17] = -1.0;
	[18] = -2.0;
	[19] = -1.25;
	[20] = 0.52359878;
	[21] = 1.57079633;
	[22] = 3.14159265;
	[23] = 6.28318531;
	[24] = 2.09439510;
	[25] = 4.71238898;
	[26] = -0.52359878;
	[27] = 1.41421356;
	[28] = 2.5;
	[29] = 0.875;
	[30] = 0.0;
	[31] = 256.0;

.asm
EXEC
	ALU:
		ALU0:	@P0@
		ALU1:	@P1@
		ALU2:	@P2@
		ALU3:	@P3@
;
EXEC
	MFU:	@W0@
	MFU:	@W1@
	MFU:	@W2@
	ALU:
		ALU0:	@C0@
		ALU1:	@C1@
		ALU2:	@C2@
		ALU3:	@C3@
;
EXEC
	MFU:	@W3@
	MFU:	@W4@
	MFU:	@W5@
;
EXEC
	MFU:	@W6@
	MFU:	@W7@
	MFU:	@W8@
;
EXEC
	MFU:	@W9@
	MFU:	@W10@
	MFU:	@W11@
;
EXEC
	MFU:	@W12@
	MFU:	@W13@
	MFU:	@W14@
;
EXEC
	MFU:	@W15@
	MFU:	@W16@
	MFU:	@W17@
;
EXEC
	ALU:
		ALU0:	@A0@
		ALU1:	@A1@
		ALU2:	@A2@
		ALU3:	@A3@
;
EXEC
	DW:	@STORE@
;
