/*
 * Lane order of a store that runs one batch after the ALU writes.
 *
 * Batch 0 puts four distinct values into r0..r3, batch 1 stores one of the two
 * row pairs. The four values print as different codes, so the word names which
 * row the first store operand reads.
 */

alu_buffer_size = 1
pseq_to_dw_exec_nb = 1

.constants
	[0] = @V0@;
	[1] = @V1@;
	[2] = @V2@;
	[3] = @V3@;

.asm
EXEC
	ALU:
		ALU0:	MAD  r0.lh,  u0,  #1,  #0
		ALU1:	MAD  r1.lh,  u1,  #1,  #0
		ALU2:	MAD  r2.lh,  u2,  #1,  #0
		ALU3:	MAD  r3.lh,  u3,  #1,  #0
;
EXEC
	DW:	store rt1, @LO@, @HI@
;
