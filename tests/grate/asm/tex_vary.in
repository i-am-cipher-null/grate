alu_buffer_size = 1
pseq_to_dw_exec_nb = 1

/*
 * Varying-coordinate TEX template.
 *
 * batch 0  the varying setup instruction, then two optional ALU slots
 * batch 1  the fetch
 * batch 2  the store to the observed surface
 *
 * The varying arrives in r0..r3 as fp20 in the high half, which is what TEX
 * reads for its coordinates, so no conversion is needed. Storing r0/r1 in
 * batch 2 records the coordinate values the fetch used; storing r2/r3 records
 * the sampled texel.
 *
 * The varying setup is the same set of MFU instructions the known-good varying
 * control (asm/fs_vs_tests.txt) uses: an rcp, two barrier multiplies, and an
 * interpolator instruction with four fp20 slots.
 */

.constants
    [1] = 0.0625;
    [2] = 0.5;
    [3] = 2.0;

.asm
EXEC
    MFU: sfu: rcp r4
         mul0: bar, sfu, bar0
         mul1: bar, sfu, bar1
         ipl: t0.fp20, t0.fp20, t0.fp20, t0.fp20
    ALU:
        ALU0: P0A_SLOT
        ALU1: P0B_SLOT
        ALU2: NOP
        ALU3: NOP
    DW: NOP
;
EXEC
    TEX: TEXWORD
    DW: NOP
;
EXEC
    DW: STORE
;
