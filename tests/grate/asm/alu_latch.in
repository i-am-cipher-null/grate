alu_buffer_size = @ABUF@
pseq_to_dw_exec_nb = 1

/*
 * ALU result-register template: four batches, four scalar slots each, one DW
 * operation per batch so a store can sit in whichever batch the variant needs.
 *
 * The old result-register set (section 9) put a reader in the packet after the
 * producer and always at alu_buffer_size 1, where every batch is its own group.
 * That conflates two boundaries: the packet boundary inside a group and the
 * batch/group boundary that flushes the ALU buffer. At size 2 two batches share
 * a group, so a producer in batch 0 and a reader in batch 1 are separated by a
 * packet boundary only.
 *
 * Nothing is primed. A reader instruction always writes its destination, so a
 * zero in the stored word means the latch read zero; the variants that copy a
 * row register (`*-row`) and the ones that write a row register directly
 * (`*-direct`) are the controls that show a non-zero value does reach the store
 * at each distance.
 *
 * Values: u0 = 0.0625 (0x10), u1 = 0.25 (0x40), u2 = 0.5 (0x7F), u3 = 0.125
 * (0x20) as fx10 bytes. `store rt1, r0, r1` stores r1.hi, r1.lo, r0.hi, r0.lo
 * from the MSB, so byte 0 is r0.lo.
 *
 * A batch whose DW slot is NOP does not store. At alu_buffer_size 2 a group is
 * two batches and only a DW in the group's first batch produces an observable
 * store (section 3), so the store sits in an even batch in every size-2
 * variant, and the readers are in the batch before it when the point is the
 * packet boundary.
 *
 * Six batches, not four, because the size-3 variants need whole groups: a
 * four-batch program at size 3 leaves an incomplete group and the draw hangs
 * (measured - two variants timed out at 20 s before the template grew). The
 * variants that use fewer batches leave the rest NOP, and at sizes 1 and 2 the
 * extra batches are groups of their own with no store.
 */

.constants
	[0] = 0.0625;
	[1] = 0.25;
	[2] = 0.5;
	[3] = 0.125;

.asm
EXEC
	ALU:
		ALU0:	@A0@
		ALU1:	@A1@
		ALU2:	@A2@
		ALU3:	@A3@
	DW:	@D0@
;
EXEC
	ALU:
		ALU0:	@B0@
		ALU1:	@B1@
		ALU2:	@B2@
		ALU3:	@B3@
	DW:	@D1@
;
EXEC
	ALU:
		ALU0:	@C0@
		ALU1:	@C1@
		ALU2:	@C2@
		ALU3:	@C3@
	DW:	@D2@
;
EXEC
	ALU:
		ALU0:	@E0@
		ALU1:	@E1@
		ALU2:	@E2@
		ALU3:	@E3@
	DW:	@D3@
;
EXEC
	ALU:
		ALU0:	@F0@
		ALU1:	@F1@
		ALU2:	@F2@
		ALU3:	@F3@
	DW:	@D4@
;
EXEC
	ALU:
		ALU0:	@G0@
		ALU1:	@G1@
		ALU2:	@G2@
		ALU3:	@G3@
	DW:	@D5@
;
