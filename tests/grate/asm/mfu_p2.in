/*
 * Does the major-axis selector read interpolated (IPL) values, and in which
 * bundle does it see them?
 *
 * Batch 0 is an MFU word whose ipl fields fetch the varying into rows (no sfu),
 * batch 1 is the sfu word under test with its own ipl operand so the same word
 * can be run with the fetch, without it, or with both in one bundle, batch 2
 * copies a row into the store pair through the ALU, batch 3 stores it.
 *
 * `ipl: t0.fp20, t0.fp20, t0.fp20, NOP` fetches varying components x, y and z
 * into rows 0, 1 and 2. Readback: `store rt1, X, Y` puts code(X) in byte 1 and
 * code(Y) in byte 3, code = 0xF7 + 8*log2(value), 0.0 = 00, 2.0 and above
 * clip to FF.
 */

alu_buffer_size = 1
pseq_to_dw_exec_nb = 1

.asm
EXEC
	MFU:	ipl: @IPL1@
;
EXEC
	MFU:	sfu: @SFU@
		@MUL0@
		@MUL1@
		ipl: @IPL2@
;
EXEC
	ALU:
		ALU0:	@POST0@
		ALU1:	@POST1@
;
EXEC
	DW:	store rt1, @LO@, @HI@
;
