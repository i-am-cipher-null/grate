alu_buffer_size = @ABUF@
pseq_to_dw_exec_nb = 1

/*
 * Four-packet group, 3 + 1 packing: three packets in group A's first batch and
 * one in its second, at `alu_buffer_size` 2.
 *
 * Notes 38 measured four packets per group in the 2 + 2 packing (two `ALU:`
 * blocks in each of two batches) and found the forward map complete with only
 * latch 3's wrap working, while one packet per batch at size 4 had the whole
 * map. The open question is whether the packing or the group size decides that,
 * so this template changes only the packing: the group still holds four packets
 * and the buffer size is still 2.
 *
 *   batch 0  packet 0   slots 0..3    A0..A3    group A
 *            packet 1   slots 4..7    A4..A7
 *            packet 2   slots 8..11   A8..A11
 *   batch 1  packet 3   slots 12..15  B0..B3
 *   batch 2  C0..C3                  group B (store for group A's readers)
 *   batch 3  E0..E3                  group B
 *   batch 4  F0..F3                  group C (store for group B's readers)
 *   batch 5  G0..G3                  group C
 *
 * Six batches is three whole groups at size 2. The assembler sets each batch's
 * schedule count from its block count, so batch 0 emits count 3 at packet
 * address 0 and batch 1 count 1 at address 3; no schedule word is patched and
 * `dump_sched_words.py` reads the counts back from the run's own dump.
 *
 * Three `ALU:` blocks in one batch is the grammar's maximum (notes 32 used the
 * same twelve-slot batch). A latch read is served by the previous packet of the
 * group, so in this packing packet 3 is the only packet of the second batch and
 * the wrap 0 <- 3 crosses the batch boundary while the 2 -> 3 edge stays inside
 * batch 0.
 *
 * Values: u0 = 0.0625 (0x10), u1 = 0.125 (0x20), u2 = 0.25 (0x40), u3 = 0.375
 * (0x60) as fx10, so a stored byte names the packet that wrote it.
 */

.constants
	[0] = 0.0625;
	[1] = 0.125;
	[2] = 0.25;
	[3] = 0.375;

.asm
EXEC
	ALU:
		ALU0:	@A0@
		ALU1:	@A1@
		ALU2:	@A2@
		ALU3:	@A3@
	ALU:
		ALU0:	@A4@
		ALU1:	@A5@
		ALU2:	@A6@
		ALU3:	@A7@
	ALU:
		ALU0:	@A8@
		ALU1:	@A9@
		ALU2:	@A10@
		ALU3:	@A11@
	DW:	@D0@
;
EXEC
	ALU:
		ALU0:	@B0@
		ALU1:	@B1@
		ALU2:	@B2@
		ALU3:	@B3@
	DW:	@D1@
;
EXEC
	ALU:
		ALU0:	@C0@
		ALU1:	@C1@
		ALU2:	@C2@
		ALU3:	@C3@
	DW:	@D2@
;
EXEC
	ALU:
		ALU0:	@E0@
		ALU1:	@E1@
		ALU2:	@E2@
		ALU3:	@E3@
	DW:	@D3@
;
EXEC
	ALU:
		ALU0:	@F0@
		ALU1:	@F1@
		ALU2:	@F2@
		ALU3:	@F3@
	DW:	@D4@
;
EXEC
	ALU:
		ALU0:	@G0@
		ALU1:	@G1@
		ALU2:	@G2@
		ALU3:	@G3@
	DW:	@D5@
;
