/*
 * What do the compiler's two multipliers compute?
 *
 * Batch 0 loads r0, r1 and r2 from fragment constants. Batch 1 is the word the
 * proprietary compiler emits for a uniform vec3 samplerCube coordinate
 * (`0x28689402 0x00000000`): `sfu: rcp r10` plus `mul0: r0, r2, r0` and
 * `mul1: r1, r2, r1`. Batch 1 stores r0 and r1.
 *
 * Readback: `store rt1, r0, r1` -> `code(r1) << 24 | code(r0) << 8`, a lane
 * printing about `0xF7 + 8*log2(value)` and clipping at `0xFF`. Seeds
 * r0 = 1.5 (`FB`), r1 = 3.0 (`FF`), r2 = 0.5 predict products r0 = 0.75
 * (`F3`) and r1 = 1.5 (`FB`) if each multiplier is r2 times its own row. The
 * `seed-echo` variant multiplies both rows by 1.0 and calibrates both constants
 * in the same run, and `product-nosfu` runs the same two multipliers with no
 * sfu sub-instruction.
 */

alu_buffer_size = 1
pseq_to_dw_exec_nb = 1

.constants
	[0] = 1.5;
	[1] = 3.0;
	[2] = 0.5;
	[3] = -0.5;

.asm
EXEC
	ALU:
		ALU0:	@SEED0@
		ALU1:	@SEED1@
		ALU2:	@SEED2@
		ALU3:	NOP
;
EXEC
	MFU:	sfu: @SFU@
		@MUL0@
		@MUL1@
		ipl: NOP, NOP, NOP, NOP
	DW:	store rt1, r0, r1
;
