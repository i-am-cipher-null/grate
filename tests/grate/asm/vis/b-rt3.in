/* Generated by tests/grate/asm/make_pseq_vis.py from pseq_split_b.in.
 * The placeholders are already substituted, because extra draws are
 * given to the assembler as files and cannot be rewritten by the
 * runner. */

alu_buffer_size = 1
pseq_to_dw_exec_nb = 1

/*
 * PSEQ separate-draw probe, draw B: fetch, then store the fetched word to the
 * observation surface, writing nothing to the fetch source.
 *
 * Batch 0 loads pattern B (0x9F607F40) into r0/r1, so a fetch that never
 * happened shows up as B rather than as whatever the registers held. Batch 1
 * is the fetch, batch 2 stores r0/r1 to the linear rt4 surface that
 * GRATE_REGION reads back. A fetched tag (0xBF9F<y+1><x+1>) is therefore
 * distinguishable from a dead fetch (B), from a zero source (0), and from the
 * pattern C surface (0x10703020).
 */

.constants
	[0] = 0.25;
	[1] = 0.5;
	[2] = 0.375;
	[3] = 0.625;

.asm
EXEC
	ALU:
		ALU0:	MAD  r0.l*,  u0,  #1,  #0
		ALU1:	MAD  r0.*h,  u1,  #1,  #0
		ALU2:	MAD  r1.l*,  u2,  #1,  #0
		ALU3:	MAD  r1.*h,  u3,  #1,  #0
	DW:	NOP
;
EXEC
	PSEQ:	0x00830008
	DW:	NOP
;
EXEC
	DW:	store rt4, r0, r1
;
