/* Generated by tests/grate/asm/make_pseq_vis.py from pseq_split_bw.in.
 * The placeholders are already substituted, because extra draws are
 * given to the assembler as files and cannot be rewritten by the
 * runner. */

alu_buffer_size = 1
pseq_to_dw_exec_nb = 1

/*
 * PSEQ fetch probe with a write to the source, in either order.
 *
 * batch 0  load pattern B (0x9F607F40) into r0/r1
 * batch 1  PRE_STORE: an optional store to the fetch source
 * batch 2  the fetch
 * batch 3  POST_STORE: an optional store to the fetch source
 * batch 4  store r0/r1 to the observation surface
 *
 * A fetch that never happened leaves pattern B in r0/r1, so the observation
 * surface shows B; a fetch that ran shows the tag the earlier draw wrote, or B
 * if the pre-store reached the source before the fetch did. The two stores let
 * one fragment write the source on either side of its own fetch, which is the
 * ordering question the separate-draw set could not ask.
 */

.constants
	[0] = 0.25;
	[1] = 0.5;
	[2] = 0.375;
	[3] = 0.625;

.asm
EXEC
	ALU:
		ALU0:	MAD  r0.l*,  u0,  #1,  #0
		ALU1:	MAD  r0.*h,  u1,  #1,  #0
		ALU2:	MAD  r1.l*,  u2,  #1,  #0
		ALU3:	MAD  r1.*h,  u3,  #1,  #0
	DW: NOP
;
EXEC
	DW: NOP
;
EXEC
	PSEQ: 0x00850008
	DW: NOP
;
EXEC
	DW: store rt5, r0, r1
;
EXEC
	DW: store rt4, r0, r1
;
