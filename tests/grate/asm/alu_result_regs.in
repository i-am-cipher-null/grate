alu_buffer_size = 1
pseq_to_dw_exec_nb = 1

/*
 * ALU result-register timing template: four packets, four scalar slots each.
 *
 * The row-register forwarding set showed no consumer ever saw a producer's
 * write in the same packet. The ISA also has explicit ALUN result registers as
 * sources (`MAD r3.l*, alu1, ...`), which is the other way a slot can name
 * another slot's output, so this template measures where those values come
 * from and when.
 *
 * packet 0  A0..A3   producers whose results can be read later
 * packet 1  B0..B3   producers and/or the first reader
 * packet 2  C0..C3   producers and/or the second reader
 * packet 3  E0..E3   optional second reader
 * DW        D0..D3   exactly one of these stores in each variant
 *
 * Each reader writes r3.l* so the store's high byte is its value; the word is
 * r3.hi, r3.lo, r2.hi, r2.lo from the MSB. Distinct powers of two per packet
 * (0.0625, 0.125, 0.25, 0.5 = 0x10, 0x20, 0x40, 0x7F) mean a readback names
 * the packet whose producer it saw.
 */

.constants
	[0] = 0.0625;
	[1] = 0.125;
	[2] = 0.25;
	[3] = 0.375;
	[4] = 0.5;
	[5] = 0.625;
	[6] = 0.75;
	[7] = 0.875;

.asm
EXEC
	ALU:
		ALU0:	@A0@
		ALU1:	@A1@
		ALU2:	@A2@
		ALU3:	@A3@
	DW:	@D0@
;
EXEC
	ALU:
		ALU0:	@B0@
		ALU1:	@B1@
		ALU2:	@B2@
		ALU3:	@B3@
	DW:	@D1@
;
EXEC
	ALU:
		ALU0:	@C0@
		ALU1:	@C1@
		ALU2:	@C2@
		ALU3:	@C3@
	DW:	@D2@
;
EXEC
	ALU:
		ALU0:	@E0@
		ALU1:	@E1@
		ALU2:	@E2@
		ALU3:	@E3@
	DW:	@D3@
;
