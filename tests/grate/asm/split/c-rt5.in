/* Generated by tests/grate/asm/make_pseq_split.py from pseq_split_c.in.
 * The placeholders are already substituted, because extra draws are
 * given to the assembler as files and cannot be rewritten by the
 * runner. */

alu_buffer_size = 1
pseq_to_dw_exec_nb = 1

/*
 * PSEQ separate-draw probe, draw A with a second picture: write pattern C
 * (0x10703020), no fetch.
 *
 * Run between draw A and draw B it changes the source surface after the tag
 * map was written, so a fetch that truly reads the surface returns C
 * everywhere and a fetch that kept the tag store or the earlier contents
 * returns tags.
 */

.constants
	[4] = 0.125;
	[5] = 0.1875;
	[6] = 0.4375;
	[7] = 0.0625;

.asm
EXEC
	ALU:
		ALU0:	MAD  r0.l*,  u4,  #1,  #0
		ALU1:	MAD  r0.*h,  u5,  #1,  #0
		ALU2:	MAD  r1.l*,  u6,  #1,  #0
		ALU3:	MAD  r1.*h,  u7,  #1,  #0
	DW:	store rt5, r0, r1
;
