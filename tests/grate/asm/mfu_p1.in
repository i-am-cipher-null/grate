/*
 * Priority 1: what do the multipliers compute when the sfu source is a special
 * index, with the multiplier execution separated from the store?
 *
 * Batch 0 seeds r0..r3 from four fragment constants (.lh, fp20). Batch 1 is the
 * MFU word under test and stores nothing. Batch 2 copies the row worth reading
 * into r0/r1 through the ALU, so the DW store of batch 3 always uses the
 * r0/r1 pair and never depends on the r2/r3 pair being reliable.
 *
 * Seeds are chosen so the selected maximum is not an operand of the word unless
 * a variant wants it: pattern A r0=4.0 (maximum), r1=0.25, r2=0.5, r3=1.0, so
 * `rcp r10` = 0.25 (E7) and the ordinary product r2*#1 = 0.5 (EF) is a clean
 * baseline. Patterns B and C move the maximum to r1 and r2.
 *
 * Readback: `store rt1, X, Y` puts code(X) in byte 1 and code(Y) in byte 3,
 * code = 0xF7 + 8*log2(value), 0.0 = 00, at or above 2.0 clips to FF.
 */

alu_buffer_size = 1
pseq_to_dw_exec_nb = 1

.constants
	[0] = @V0@;
	[1] = @V1@;
	[2] = @V2@;
	[3] = @V3@;

.asm
EXEC
	ALU:
		ALU0:	MAD  r0.lh,  u0,  #1,  #0
		ALU1:	MAD  r1.lh,  u1,  #1,  #0
		ALU2:	MAD  r2.lh,  u2,  #1,  #0
		ALU3:	MAD  r3.lh,  u3,  #1,  #0
;
EXEC
	MFU:	sfu: @SFU@
		@MUL0@
		@MUL1@
		ipl: NOP, NOP, NOP, NOP
;
EXEC
	ALU:
		ALU0:	@POST0@
		ALU1:	@POST1@
;
EXEC
	DW:	store rt1, @LO@, @HI@
;
