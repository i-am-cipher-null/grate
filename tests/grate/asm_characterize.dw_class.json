					"@Y2@": "MAD  r3.l*,  u14,  #1,  #0",
					"@Q3@": "MAD  r1.*h,  u7,  #1,  #0",
					"@Y3@": "MAD  r3.*h,  u15,  #1,  #0",
					"@DW0@": "store rt1, r0, r1",
					"@DW1@": "store rt0, r0, r1 class 1",
					"@FETCH@": "load rt1, r0, r1",
					"@STORE@": "store rt1, r0, r1"
				}
			},
			"environment": {
				"GRATE_DEPTH": "1",
				"GRATE_DUMP_RAW": "1"
			},
			"expected_note": "the same two words with the batches swapped: the same two readings, with the target that wins swapped",
			"expected": "0x3D2C1B0A"
