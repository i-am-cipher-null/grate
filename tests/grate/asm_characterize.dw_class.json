{
	"name": "dw-class",
	"repeat": 3,
	"timeout": 20,
	"program": {
		"vs": "tests/grate/asm/vs_mov.txt",
		"fs": "tests/grate/asm/dw_class.in",
		"lnk": "tests/grate/asm/linker_vs_tests.txt"
	},
	"controls": [
		{
			"name": "immediate-operand",
			"vs": "tests/grate/asm/vs_mov.txt",
			"fs": "tests/grate/asm/fs_alu_immediate_control.txt",
			"lnk": "tests/grate/asm/linker_vs_tests.txt",
			"expected": "0x000000FF"
		},
		{
			"name": "varying-pipeline",
			"vs": "tests/grate/asm/vs_mov.txt",
			"fs": "tests/grate/asm/fs_vs_tests.txt",
			"lnk": "tests/grate/asm/linker_vs_tests.txt",
			"expected": "0xFF01FF00"
		}
	],
	"variants": [
		{
			"name": "depth-then-colour",
			"fs": "tests/grate/asm/dw_class.in",
			"replace": {
				"fs": {
					"@ABUF@": "2",
					"@P0@": "MAD  r0.l*,  u0,  #1,  #0",
					"@X0@": "MAD  r2.l*,  u12,  #1,  #0",
					"@P1@": "MAD  r0.*h,  u1,  #1,  #0",
					"@X1@": "MAD  r2.*h,  u13,  #1,  #0",
					"@P2@": "MAD  r1.l*,  u2,  #1,  #0",
					"@X2@": "MAD  r3.l*,  u14,  #1,  #0",
					"@P3@": "MAD  r1.*h,  u3,  #1,  #0",
					"@X3@": "MAD  r3.*h,  u15,  #1,  #0",
					"@Q0@": "MAD  r0.l*,  u4,  #1,  #0",
					"@Y0@": "MAD  r2.l*,  u12,  #1,  #0",
					"@Q1@": "MAD  r0.*h,  u5,  #1,  #0",
					"@Y1@": "MAD  r2.*h,  u13,  #1,  #0",
					"@Q2@": "MAD  r1.l*,  u6,  #1,  #0",
					"@Y2@": "MAD  r3.l*,  u14,  #1,  #0",
					"@Q3@": "MAD  r1.*h,  u7,  #1,  #0",
					"@Y3@": "MAD  r3.*h,  u15,  #1,  #0",
					"@DW0@": "store rt0, r0, r1 class 1",
					"@DW1@": "store rt1, r0, r1",
					"@FETCH@": "load rt1, r0, r1",
					"@STORE@": "store rt1, r0, r1"
				}
			},
			"environment": {
				"GRATE_DEPTH": "1",
				"GRATE_DUMP_RAW": "1"
			},
			"expected_note": "class-1 depth word in batch 0, class-2 colour word on rt1 in batch 1: colour 0x4C4C4C4C and depth 0x4000 if the first word wins, colour 0x3D2C1B0A and depth 0x8000 if the second does",
			"expected": "0x00000000"
		},
