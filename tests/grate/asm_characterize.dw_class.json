					"@Q2@": "MAD  r1.l*,  u6,  #1,  #0",
					"@Y2@": "MAD  r3.l*,  u14,  #1,  #0",
					"@Q3@": "MAD  r1.*h,  u7,  #1,  #0",
					"@Y3@": "MAD  r3.*h,  u15,  #1,  #0",
					"@DW0@": "store rt1, r0, r1",
