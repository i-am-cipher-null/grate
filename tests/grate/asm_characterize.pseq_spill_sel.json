{
	"name": "pseq-spill-sel",
	"repeat": 5,
	"timeout": 20,
	"program": {
		"vs": "tests/grate/asm/vs_mov.txt",
		"fs": "tests/grate/asm/pseq_spill_sel.in",
		"lnk": "tests/grate/asm/linker_vs_tests.txt"
	},
	"controls": [
		{
			"name": "immediate-operand",
			"vs": "tests/grate/asm/vs_mov.txt",
			"fs": "tests/grate/asm/fs_alu_immediate_control.txt",
			"lnk": "tests/grate/asm/linker_vs_tests.txt",
			"expected": "0x000000FF"
		},
		{
			"name": "varying-pipeline",
			"vs": "tests/grate/asm/vs_mov.txt",
			"fs": "tests/grate/asm/fs_vs_tests.txt",
			"lnk": "tests/grate/asm/linker_vs_tests.txt",
			"expected": "0xFF01FF00"
		}
	],
	"variants": [
		{
			"name": "sel-none",
			"fs": "tests/grate/asm/pseq_spill_sel.in",
			"replace": {
				"fs": {
					"SEL_WORD": "0x01000000"
				}
			},
			"environment": {
				"GRATE_RT4": "1"
			},
			"expected_note": "bits none beside 24",
			"expected": "0x44332211"
		},
		{
			"name": "sel-b23",
			"fs": "tests/grate/asm/pseq_spill_sel.in",
			"replace": {
				"fs": {
					"SEL_WORD": "0x01800000"
				}
			},
			"environment": {
				"GRATE_RT4": "1"
			},
