			"fs": {"@IPL@": "NOP, NOP, t0.fp20, NOP", "@C0@": "NOP", "@C1@": "NOP", "@STORE@": "store rt4, r2, r3"},
			"lnk": {"@LINK@": "LINK fp20, fp20, fp20, fp20, tram0.xyzw, export0"}},
			"environment": {"GRATE_REGION": "15,0,2,1"}},
		{"name": "slope-right", "replace": {
			"fs": {"@IPL@": "NOP, NOP, t0.fp20, NOP", "@C0@": "NOP", "@C1@": "NOP", "@STORE@": "store rt4, r2, r3"},
			"lnk": {"@LINK@": "LINK fp20, fp20, fp20, fp20, tram0.xyzw, export0"}},
